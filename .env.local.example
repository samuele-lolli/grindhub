# Supabase — public (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-only (NEVER exposed to browser)
# Required for: account deletion (/api/user/delete)
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for SEO metadata, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=https://grindhub-ashy.vercel.app
